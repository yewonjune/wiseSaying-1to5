# 이 파일을 db.properties 로 복사해 접속 정보를 채우세요. (db.properties 는 git 에 올라가지 않습니다)
# 환경변수가 있으면 환경변수가 우선합니다:
#   WISE_SAYING_DB_HOST, WISE_SAYING_DB_PORT, WISE_SAYING_DB_USERNAME,
#   WISE_SAYING_DB_PASSWORD, WISE_SAYING_DB_NAME, WISE_SAYING_DB_TEST_NAME
db.host=localhost
db.port=3306
db.username=root
db.password=
# 개발(실행)용 DB
db.name=wiseSaying_dev
# 테스트용 DB (테스트는 매번 테이블을 비우므로 꼭 따로 두세요)
db.testName=wiseSaying_test
